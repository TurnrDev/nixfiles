{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/London",
  "schedule": ["* 0-3 * * *"],
  "automerge": false,
  "automergeType": "pr",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3,12-15 * * *"]
  },
  "nix": {
    "enabled": true
  },
  "customManagers": [
    {
      "description": "Update the Borg 2 release binary and its SHA-256 hash",
      "customType": "regex",
      "managerFilePatterns": ["/^packages/borg2/default\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+version = \\\"(?<currentValue>[^\\\"]+)\\\";[\\s\\S]*?sha256 = \\\"(?<currentDigest>[a-f0-9]{64})\\\";"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group Nix updates twice daily and automerge them",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs",
      "schedule": ["* 0-3,12-15 * * *"],
      "automerge": true,
      "platformAutomerge": false
    }
  ]
}
