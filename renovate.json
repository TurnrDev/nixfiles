{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/London",
  "schedule": ["* 0-3 * * *"],
  "automerge": false,
  "automergeType": "pr",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["* 0-3,12-15 * * *"]
  },
  "nix": {
    "enabled": true
  },
  "customDatasources": {
    "es-de": {
      "defaultRegistryUrlTemplate": "https://gitlab.com/es-de/emulationstation-de/-/raw/master/latest_release.json",
      "transformTemplates": [
        "{\"releases\":[{\"version\":stable.version}],\"sourceUrl\":\"https://gitlab.com/es-de/emulationstation-de\",\"homepage\":website}"
      ]
    }
  },
  "customManagers": [
    {
      "description": "Update the Borg 2 release binary and its SHA-256 hash",
      "customType": "regex",
      "managerFilePatterns": ["/^packages/borg2/default\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+version = \\\"(?<currentValue>[^\\\"]+)\\\";[\\s\\S]*?sha256 = \\\"(?<currentDigest>[a-f0-9]{64})\\\";"
      ]
    },
    {
      "description": "Update GitHub release binaries and their SHA-256 hashes",
      "customType": "regex",
      "managerFilePatterns": [
        "/^packages/(greenlight|kytyps5|sharpemu)/default\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+releaseTag = \\\"(?<currentValue>[^\\\"]+)\\\";[\\s\\S]*?sha256 = \\\"(?<currentDigest>[a-f0-9]{64})\\\";"
      ]
    },
    {
      "description": "Update ES-DE from its official release manifest",
      "customType": "regex",
      "managerFilePatterns": ["/^packages/es-de/default\\.nix$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) versioning=(?<versioning>\\S+)\\s+version = \\\"(?<currentValue>[^\\\"]+)\\\";"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Group Nix updates twice daily and automerge them",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs",
      "schedule": ["* 0-3,12-15 * * *"],
      "automerge": true,
      "platformAutomerge": false
    },
    {
      "description": "Disable pinning Docker images to a specific digest/hash (undoes config:best-practices default)",
      "matchDatasources": ["docker"],
      "pinDigests": false
    },
    {
      "description": "Disable pinning GitHub Actions to a specific digest/hash (undoes config:best-practices default)",
      "matchDepTypes": ["action", "workflow"],
      "pinDigests": false
    }
  ]
}
